table events
	lineageTag: e68978d0-170c-5681-9cfe-02ede0ea37f4

	measure 'Avg Pass Difficulty' = AVERAGE(events[pass_difficulty])
		formatString: 0.0
		lineageTag: 075f9929-9f55-5ac7-b13c-0157411acc51

	measure 'xT Added' = SUM(events[xt_added])
		formatString: 0.000
		lineageTag: 28e370e3-a49a-5ed3-81fe-7d8a54169677

	/// Home-relative momentum from -1 (away on top) to +1 (home on top); read it per match and phase, not per club.
	measure 'Avg Momentum' = AVERAGE(events[momentum])
		formatString: +0.00;-0.00;0.00
		lineageTag: b2035049-fd6d-51ea-9ba3-8c3fdc70a4a1

	/// Share of all passes in the current match and phase made by the filtered club: a possession proxy.
	measure 'Pass Share %' =
			VAR TeamPasses = CALCULATE(COUNTROWS(events), events[event_type] = "pass")
			VAR AllPasses = CALCULATE(COUNTROWS(events), events[event_type] = "pass", REMOVEFILTERS(clubs))
			RETURN DIVIDE(TeamPasses, AllPasses)
		formatString: 0.0%
		lineageTag: c34e19e9-f966-5605-9766-87f9f80a4ea4


table players
	lineageTag: 2d1148c3-e7af-565c-9985-719a88b99e5b

	measure Goals = SUM(players[goals])
		formatString: 0
		lineageTag: faa3a11e-3b5e-5db8-aece-db908e0655f0

	measure 'Expected Goals' = SUM(players[xg])
		formatString: 0.00
		lineageTag: 6f57e3ef-bcc5-5cff-b903-3505b2828072

	measure 'Goals minus xG' = [Goals] - [Expected Goals]
		formatString: +0.00;-0.00;0.00
		lineageTag: 69e10063-300c-5a14-bded-c1d022cba0b5

	measure Shots = SUM(players[shots])
		formatString: 0
		lineageTag: 68c7c8f7-9396-5fef-adb0-591dc0c781bc

	measure 'Pass Accuracy %' = DIVIDE(SUM(players[passes_completed]), SUM(players[passes_attempted]))
		formatString: 0.0%
		lineageTag: aa8975be-e733-5e7a-b04a-000ed4585645


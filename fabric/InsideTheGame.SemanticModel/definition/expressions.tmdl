/// Direct Lake source: replace <SQL_ENDPOINT> and <LAKEHOUSE_SQL_ENDPOINT_ID> from the lakehouse SQL analytics endpoint settings (see docs/FABRIC.md).
expression DatabaseQuery =
		let
			database = Sql.Database("<SQL_ENDPOINT>", "<LAKEHOUSE_SQL_ENDPOINT_ID>")
		in
			database
	lineageTag: 2d6b8f0a-4c1e-4a3b-8d5f-7e9a1b3c5d70

{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "webImageName": { "value": "${SERVICE_WEB_IMAGE_NAME=}" },
    "modelName": { "value": "${AZURE_MODEL_NAME=gpt-4.1-mini}" },
    "modelVersion": { "value": "${AZURE_MODEL_VERSION=2025-04-14}" },
    "modelCapacity": { "value": "${AZURE_MODEL_CAPACITY=30}" },
    "mcpApiKey": { "value": "${MCP_API_KEY=}" }
  }
}
